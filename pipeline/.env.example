# Copy to .env in your content directory (CONTENT_DIR, default: this folder). Never commit .env.
# <ID> = channel id from shorts.config.json in upper case, e.g. A.

# ElevenLabs – narration (pnpm make --narrator, voice-fix, voice-samples)
ELEVENLABS_API_KEY=
# Voice IDs referenced by "voiceIdEnv" in shorts.config.json
ELEVENLABS_VOICE_NARRATOR_A=
ELEVENLABS_VOICE_NARRATOR_B=

# YouTube Data API – OAuth client of type "Desktop app" (pnpm yt-auth fills in the rest)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN_A=
YT_CHANNEL_ID_A=

# Instagram API – system user token with instagram_content_publish (+ instagram_manage_insights for stats)
IG_ACCESS_TOKEN_A=
IG_USER_ID_A=
