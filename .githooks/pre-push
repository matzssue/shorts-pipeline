#!/bin/sh
# Blocks a push when any pushed commit (content or message) contains a word from a private denylist.
# The denylist lives OUTSIDE this repo, so the list itself never becomes public.
#
# Setup (once per clone):
#   git config core.hooksPath .githooks
#   git config hooks.denylist /absolute/path/to/denylist.txt   # one fixed string per line, case-insensitive
#
# Without a configured denylist the push is blocked – set it, or bypass consciously with --no-verify.

list=$(git config --get hooks.denylist)
if [ -z "$list" ] || [ ! -f "$list" ]; then
  echo "pre-push: no denylist (git config hooks.denylist <file>) – push blocked." >&2
  exit 1
fi

zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # deleting a branch
  if [ "$remote_sha" = "$zero" ]; then range="$local_sha"; else range="$remote_sha..$local_sha"; fi
  for commit in $(git rev-list "$range"); do
    hits=$(git grep -I -n -i -F -f "$list" "$commit" -- . 2>/dev/null)
    if [ -n "$hits" ]; then
      echo "pre-push: denylisted text in $commit:" >&2
      echo "$hits" | sed 's/^/  /' >&2
      status=1
    fi
    if git log -1 --format=%B "$commit" | grep -q -i -F -f "$list"; then
      echo "pre-push: denylisted text in the message of $commit" >&2
      status=1
    fi
  done
done

[ $status -ne 0 ] && echo "pre-push: push blocked." >&2
exit $status
